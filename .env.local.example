# Copy this file to .env.local and fill in the values for whichever provider you want to use.
# LLM_PROVIDER selects which set of vars are read at runtime.

# Pick one: "openrouter" | "groq"
LLM_PROVIDER=openrouter

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-2.6-1t:free

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
